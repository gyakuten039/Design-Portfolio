/**index.wxss**/
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #fff5f5 0%, #ffffff 100%);
}

/* 头部 */
.header {
  background: linear-gradient(135deg, #c41e3a, #8b0000);
  padding: 30rpx 40rpx;
  text-align: center;
  position: relative;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 10rpx;
}

.clear-btn {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
}

.clear-text {
  font-size: 24rpx;
  color: #fff;
}

/* 对话容器 */
.chat-container {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}

/* 欢迎语 */
.welcome-message {
  text-align: center;
  padding: 60rpx 40rpx;
}

.welcome-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.welcome-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #c41e3a;
  margin-bottom: 20rpx;
}

.welcome-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
}

.example-questions {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  text-align: left;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.example-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.example-item {
  font-size: 26rpx;
  color: #666;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.3s;
}

.example-item:last-child {
  border-bottom: none;
}

.example-item:active {
  background: #f5f5f5;
  color: #c41e3a;
}

/* 消息列表 */
.message-list {
  padding-bottom: 20rpx;
}

.message-item {
  margin-bottom: 30rpx;
}

/* 用户消息 */
.user-message {
  display: flex;
  justify-content: flex-end;
  align-items: flex-start;
}

.user-message .message-content {
  background: linear-gradient(135deg, #c41e3a, #8b0000);
  color: #fff;
  border-radius: 30rpx 30rpx 8rpx 30rpx;
  padding: 20rpx 30rpx;
  max-width: 70%;
  font-size: 30rpx;
  line-height: 1.6;
}

.user-message .message-content .user-image {
  width: 300rpx;
  border-radius: 15rpx;
  margin-bottom: 10rpx;
  display: block;
}

/* AI消息 */
.ai-message {
  display: flex;
  justify-content: flex-start;
  align-items: flex-start;
}

.ai-message .message-content {
  background: #fff;
  color: #333;
  border-radius: 8rpx 30rpx 30rpx 30rpx;
  padding: 20rpx 30rpx;
  max-width: 70%;
  font-size: 30rpx;
  line-height: 1.6;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 头像 */
.avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: bold;
  margin: 0 15rpx;
  flex-shrink: 0;
}

.user-avatar {
  background: linear-gradient(135deg, #c41e3a, #8b0000);
  color: #fff;
}

.ai-avatar {
  background: linear-gradient(135deg, #ffd700, #ff8c00);
  color: #fff;
}

/* 流式指示器 */
.streaming-indicator {
  display: flex;
  margin-top: 10rpx;
}

.dot {
  font-size: 40rpx;
  animation: blink 1.4s infinite both;
  margin: 0 2rpx;
}

.dot:nth-child(1) {
  animation-delay: 0s;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes blink {
  0%, 80%, 100% {
    opacity: 0;
  }
  40% {
    opacity: 1;
  }
}

/* 图片消息 */
.image-message {
  display: flex;
  justify-content: flex-start;
  align-items: flex-start;
}

.image-content {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  max-width: 75%;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.generated-image {
  width: 100%;
  border-radius: 10rpx;
  margin-bottom: 15rpx;
}

.image-actions {
  display: flex;
  justify-content: center;
  margin-bottom: 15rpx;
}

.save-btn {
  background: linear-gradient(135deg, #c41e3a, #8b0000);
  color: #fff;
  font-size: 26rpx;
  padding: 15rpx 40rpx;
  border-radius: 30rpx;
  border: none;
}

/* 图生图样式 */
.image-generation-message {
  display: flex;
  margin-bottom: 30rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.generation-comparison {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 15rpx;
  background: #f8f8f8;
  border-radius: 15rpx;
}

.comparison-item {
  flex: 1;
  text-align: center;
}

.comparison-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.comparison-image {
  width: 100%;
  max-width: 280rpx;
  border-radius: 10rpx;
}

.comparison-arrow {
  font-size: 40rpx;
  color: #c41e3a;
  padding: 0 20rpx;
}

.generation-prompt {
  margin-top: 15rpx;
  padding: 15rpx;
  background: #f0f8ff;
  border-radius: 10rpx;
}

.prompt-label {
  font-size: 24rpx;
  color: #666;
}

.prompt-text {
  font-size: 24rpx;
  color: #333;
  line-height: 1.5;
}

/* 图生图按钮样式 */
.img2img-btn {
  background: linear-gradient(135deg, #4a90e2, #007aff);
  color: #fff;
  font-size: 24rpx;
  padding: 15rpx 25rpx;
  border-radius: 30rpx;
  border: none;
  margin-left: 10rpx;
}

.save-btn::after {
  border: none;
}

.revised-prompt {
  background: #f8f8f8;
  border-radius: 10rpx;
  padding: 15rpx;
  font-size: 24rpx;
}

.prompt-label {
  color: #999;
  display: block;
  margin-bottom: 5rpx;
}

.prompt-text {
  color: #666;
}

/* 底部操作栏 */
.bottom-bar {
  background: #fff;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.generate-image-btn {
  width: 100%;
  background: linear-gradient(135deg, #ff8c00, #ffd700);
  color: #fff;
  font-size: 30rpx;
  padding: 25rpx 0;
  border-radius: 50rpx;
  margin-bottom: 20rpx;
  border: none;
  font-weight: bold;
}

.generate-image-btn::after {
  border: none;
}

.generate-image-btn.disabled {
  opacity: 0.5;
  background: linear-gradient(135deg, #ccc, #999);
}

.generate-image-btn.loading {
  background: linear-gradient(135deg, #ccc, #999);
}

.select-image-btn {
  width: 100%;
  background: linear-gradient(135deg, #4682b4, #1e90ff);
  color: #fff;
  font-size: 30rpx;
  padding: 25rpx 0;
  border-radius: 50rpx;
  margin-bottom: 20rpx;
  border: none;
  font-weight: bold;
}

.select-image-btn::after {
  border: none;
}

/* 已选图片预览 */
.selected-image-preview {
  position: relative;
  display: inline-block;
  margin-bottom: 15rpx;
  margin-left: 20rpx;
}

.preview-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 15rpx;
  border: 2rpx solid #e0e0e0;
}

.cancel-image-btn {
  position: absolute;
  top: -15rpx;
  right: -15rpx;
  width: 40rpx;
  height: 40rpx;
  background: #ff4444;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  z-index: 10;
}

/* 输入区域 */
.input-area {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 50rpx;
  padding: 10rpx 10rpx 10rpx 30rpx;
}

.message-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  height: 70rpx;
}

.send-btn {
  background: linear-gradient(135deg, #c41e3a, #8b0000);
  color: #fff;
  font-size: 28rpx;
  padding: 15rpx 35rpx;
  border-radius: 40rpx;
  margin-left: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-btn.disabled {
  opacity: 0.5;
  background: linear-gradient(135deg, #ccc, #999);
}

.send-btn.loading {
  background: linear-gradient(135deg, #ccc, #999);
}
